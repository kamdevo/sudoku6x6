<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<!-- StackPane: puts the background image behind and centers the card on top of it -->
<StackPane xmlns="http://javafx.com/javafx"
           xmlns:fx="http://javafx.com/fxml"
           fx:controller="com.example.sudoku6x6.controllers.MenuController"
           styleClass="root-pane" stylesheets="@styles.css"
           prefWidth="1155.0" prefHeight="650.0">

    <!-- ImageView: background image. It has the same proportions as the window -->
    <ImageView fitHeight="650.0" fitWidth="1155.0" opacity="0.91" pickOnBounds="true" preserveRatio="true">
        <image>
            <Image url="@images/background.png"/>
        </image>
    </ImageView>

    <!-- VBox: puts title, rules and buttons one below the other -->
    <VBox styleClass="card" alignment="CENTER" spacing="20.0"
          maxWidth="460.0" maxHeight="-Infinity">

        <Label text="SUDOKU 6x6" styleClass="title"/>

        <Label styleClass="subtitle" wrapText="true"
               text="Fill the grid with numbers from 1 to 6. A number cannot repeat in the same row, column or 2x3 block."/>

        <Button text="Play" onAction="#onPlayClick"
                styleClass="primary-button" defaultButton="true" prefWidth="200.0"/>
        <Button text="Exit" onAction="#onExitClick" prefWidth="200.0"/>
    </VBox>
</StackPane>
